<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Sistem Mesajı</title>
    <style>
        body { 
            background-color: black; 
            color: white; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
            font-family: sans-serif; 
            cursor: pointer;
            text-align: center;
        }
        h1 { font-size: 60px; text-shadow: 0 0 20px red; color: red; }
        p { font-size: 20px; color: #555; }
    </style>
</head>
<body onclick="calistir()">

    <div id="icerik">
        <h1>RATLADIN DOSTUM BTW</h1>
        <p>(Devam etmek için ekrana tıkla...)</p>
    </div>

    <audio id="sarki" loop>
        <source src="https://files.catbox.moe/6rge8f.mp3" type="audio/mpeg">
    </audio>

    <script>
        function calistir() {
            var ses = document.getElementById("sarki");
            ses.play();
            // Tıklayınca alttaki küçük yazıyı kaldırır
            document.querySelector("p").style.display = "none";
        }
    </script>
</body>
</html>
