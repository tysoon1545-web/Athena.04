<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Sistem Mesajı</title>
    <style>
        body { 
            background-color: black; 
            color: red; 
            display: flex; 
            flex-direction: column;
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
            font-family: 'Courier New', Courier, monospace;
            cursor: pointer;
            text-align: center;
        }
        h1 { font-size: 70px; text-shadow: 0 0 30px red; margin-bottom: 10px; }
        .sub { color: #444; font-size: 15px; letter-spacing: 2px; }
    </style>
</head>
<body onclick="playMusic()">

    <h1>Yusuf tekin istifa</h1>
    <div class="sub">DEVAM ETMEK İÇİN TIKLA</div>

    <audio id="audioPlayer" loop>
        <source src="ses.mp3" type="audio/mpeg">
    </audio>

    <script>
        function playMusic() {
            var audio = document.getElementById("audioPlayer");
            audio.play();
            // Tıklayınca alttaki yazıyı siler, sadece ana yazı kalır
            document.querySelector(".sub").style.opacity = "0";
        }
    </script>
</body>
</html>
